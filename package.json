{
  "name": "localhost-cockpit",
  "version": "0.1.0",
  "description": "See and control every development server running on your machine.",
  "keywords": [
    "localhost",
    "developer-tools",
    "cli",
    "mcp",
    "dev-server"
  ],
  "author": "Danilo Lekovic",
  "homepage": "https://github.com/danilolekovic/localhost#readme",
  "bugs": {
    "url": "https://github.com/danilolekovic/localhost/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danilolekovic/localhost.git"
  },
  "type": "module",
  "bin": {
    "localhost": "bin/localhost.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/localhost.js",
    "test": "node --test",
    "check": "node --check ./bin/localhost.js && node --check ./src/discovery.js && node --check ./src/mcp.js",
    "prepublishOnly": "npm test && npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
